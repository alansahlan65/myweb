{
  "name": "alan-sahlan-personal-website",
  "version": "0.1.0",
  "private": true,
  "description": "Alan Sahlan's personal website: selected product design work, experience, and the Shelf.",
  "author": "Alan Sahlan <alansahlanwork@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alansahlan65/myweb.git"
  },
  "scripts": {
    "build": "opennextjs-cloudflare build",
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "preview": "npm run build && opennextjs-cloudflare preview",
    "deploy": "npm run build && opennextjs-cloudflare deploy",
    "upload": "npm run build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "@opennextjs/cloudflare": "^1.20.14",
    "@tabler/icons-react": "^3.52.0",
    "lenis": "^1.3.27",
    "liquid-gooey": "0.2.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.155.0"
  }
}
